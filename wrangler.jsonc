    "ALLOWED_ORIGINS": "https://amandasever.ru,https://www.amandasever.ru,https://amandasever.kabanvovan37.workers.dev",
    "TG_ADMIN_IDS": "1348676194"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amanda-leads",
      "database_id": "d6b8d298-d0b0-4531-8f8e-fa9ba3b76fe6"
    }
  ]
}
